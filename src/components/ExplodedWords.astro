---
/*
 * The four words of the exploded axonometric, one per layer: the part's
 * name and, under it, what the studio does with that part. They are real
 * text; with the experience running each one hangs off its layer on a
 * leader line, dim until that layer is hovered or tapped. Narrow screens have
 * room for one word at a time: it shows as a caption under the stack, and the
 * scene lights the four in turn when the layers come apart.
 */
// The ids name the layers in the scene (params.ts); the words are what the visitor reads.
const LAYERS = [
  { id: 'estructura', word: 'Estructura', role: 'La calculamos y revisamos en obra.' },
  { id: 'envolvente', word: 'Muros', role: 'Los aislamos del frío y la humedad.' },
  { id: 'luz', word: 'Aberturas', role: 'Las ubicamos según el sol y la vista.' },
  { id: 'habitar', word: 'Cubierta', role: 'La impermeabilizamos y probamos con agua.' },
] as const;
---

<ul class="layer-words" data-layer-words aria-label="Capas del edificio">
  {
    LAYERS.map((layer) => (
      <li class="layer-word" data-layer-word={layer.id}>
        <span class="layer-leader" aria-hidden="true" />
        <span class="layer-label">
          <span class="layer-name">{layer.word}</span> <span class="layer-role">{layer.role}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .layer-words {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    line-height: 1.05;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .layer-leader {
    display: none;
  }

  .layer-label {
    display: grid;
    gap: 0.2rem;
  }

  /* The role reads as a quiet gloss under the name, in bone even when the name turns copper. */
  .layer-role {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: 0;
    color: var(--color-bone);
    opacity: 0.75;
  }

  /* Pinned beside the exploded layers: the scene writes --x/--y for each word. */
  :global(.js-experience) .layer-words {
    position: fixed;
    inset: 0;
    display: block;
  }

  /* The name's line sits on the layer's height (--y) and the role hangs below it. */
  :global(.js-experience) .layer-word {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    translate: var(--x, -100vw) calc(var(--y, 0px) - 0.5lh);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  :global(.js-experience) .layer-role {
    font-size: 0.85em;
  }

  :global(.js-experience) .layer-leader {
    display: block;
    flex: none;
    width: clamp(1.75rem, 4vw, 3.5rem);
    height: 1px;
    margin-top: calc(0.5lh - 0.5px);
    background: color-mix(in oklab, var(--color-bone) 45%, transparent);
    transform-origin: left center;
    transition:
      width 0.9s var(--ease-settle),
      background-color 0.9s var(--ease-settle);
  }

  /* Always readable, so nobody has to find the hover to learn the layers; the hover lights one up. */
  :global(.js-experience) .layer-label {
    opacity: 0.6;
    transition:
      opacity 0.9s var(--ease-settle),
      translate 0.9s var(--ease-settle),
      color 0.9s var(--ease-settle);
  }

  :global(.js-experience) .layer-word[data-active] .layer-leader {
    width: clamp(3rem, 7vw, 6rem);
    background: var(--color-accent);
  }

  :global(.js-experience) .layer-word[data-active] .layer-label {
    opacity: 1;
    translate: 0 0;
    color: var(--color-accent);
  }

  /* Narrow screens leave no room beside the stack: the tapped layer's word reads as a caption below it,
     hung from its layer by a plumb line that runs down from the layer's height. */
  @media (max-width: 767px) {
    :global(.js-experience) .layer-word {
      top: var(--y, 50svh);
      bottom: 13svh;
      left: 50%;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      translate: -50% 0;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 2.25rem;
      line-height: 1.05;
      text-align: center;
    }

    :global(.js-experience) .layer-label {
      justify-items: center;
      gap: 0.4rem;
    }

    :global(.js-experience) .layer-role {
      font-size: 1rem;
      white-space: nowrap;
    }

    :global(.js-experience) .layer-leader,
    :global(.js-experience) .layer-word[data-active] .layer-leader {
      flex: 1;
      width: 1px;
      height: auto;
      margin-top: 0;
      transform-origin: center top;
      scale: 1 0;
      transition: scale 0.9s var(--ease-settle);
    }

    :global(.js-experience) .layer-word[data-active] .layer-leader {
      scale: 1 1;
    }

    :global(.js-experience) .layer-label {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /* Reduced motion keeps the building whole: the words read as a plain column. */
  :global(.js-experience.reduced-motion) .layer-words {
    position: static;
    display: grid;
  }

  :global(.js-experience.reduced-motion) .layer-word {
    position: static;
    translate: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    line-height: 1.05;
  }

  :global(.js-experience.reduced-motion) .layer-role {
    font-size: 1rem;
  }

  :global(.js-experience.reduced-motion) .layer-leader {
    display: none;
  }

  :global(.js-experience.reduced-motion) .layer-label {
    opacity: 1;
    translate: none;
  }
</style>
