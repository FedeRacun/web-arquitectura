---
import { architect } from '../config/architect';
import { projectTitle } from '../config/projects';

/*
 * The studio's other houses. With the experience running, "Ver otros
 * proyectos" in the model's scene slides the camera to a row of their plans
 * drafted on the table: this list becomes the heading over the row, the
 * labels hung under each plan (the scene writes --x/--y for each, as it does
 * for the layer words), the way back and the pager. Without it, it reads as a
 * plain list after the model's sentence.
 */
const { projects } = architect;
---

<nav id="otros-proyectos" class="projects" data-projects aria-labelledby="otros-proyectos-titulo">
  <div class="projects-head">
    <h2 id="otros-proyectos-titulo" class="phrase projects-title" tabindex="-1" data-projects-title>
      Otros proyectos
    </h2>
    <button type="button" class="projects-back" data-projects-back>
      <svg class="projects-arrow" viewBox="0 0 30 12" width="30" height="12" aria-hidden="true">
        <path d="M29.5 6H1.5M6 1.5L1.5 6L6 10.5"></path>
      </svg>
      <span class="projects-back-house">Volver al sitio</span>
      <span class="projects-back-list">Volver a la lista</span>
    </button>
  </div>

  <ol class="projects-list">
    {
      projects.map((project, index) => (
        <li class="projects-item" data-project={index}>
          <span class="projects-label" data-project-label>
            <span class="projects-name">{projectTitle(project)}</span>
            <span class="projects-status">{project.status}</span>
          </span>
        </li>
      ))
    }
  </ol>

  <div class="projects-pager">
    <button type="button" class="projects-step" data-projects-step="-1" aria-label="Proyecto anterior">
      <svg viewBox="0 0 30 12" width="30" height="12" aria-hidden="true">
        <path d="M29.5 6H1.5M6 1.5L1.5 6L6 10.5"></path>
      </svg>
    </button>
    <p class="projects-count"><span data-projects-index>1</span> / {projects.length}</p>
    <button type="button" class="projects-step" data-projects-step="1" aria-label="Proyecto siguiente">
      <svg viewBox="0 0 30 12" width="30" height="12" aria-hidden="true">
        <path d="M0.5 6H28.5M24 1.5L28.5 6L24 10.5"></path>
      </svg>
    </button>
  </div>

  <div class="projects-model">
    <div class="projects-layers" role="group" aria-label="Capas de la maqueta" data-projects-layers></div>
    <div class="projects-turn">
      <button type="button" class="projects-turner" data-projects-turn="1" aria-label="Girar a la izquierda">
        <svg viewBox="0 0 28 16" width="28" height="16" aria-hidden="true">
          <path d="M4.17 5.13A12 5 0 1 1 4.17 10.87M5.88 13.93L4.17 10.87L7.67 10.92"></path>
        </svg>
      </button>
      <p class="projects-hint">Arrastrá para girar la maqueta</p>
      <button type="button" class="projects-turner" data-projects-turn="-1" aria-label="Girar a la derecha">
        <svg viewBox="0 0 28 16" width="28" height="16" aria-hidden="true">
          <path d="M23.83 5.13A12 5 0 1 0 23.83 10.87M22.12 13.93L23.83 10.87L20.33 10.92"></path>
        </svg>
      </button>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-projects-live></p>
</nav>
<div class="projects-veil" data-projects-veil aria-hidden="true"></div>

<style>
  /* The plain page: a heading and the houses as a list, after the model's sentence. */
  .projects {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 2.5rem;
    min-height: 100svh;
    padding: 6rem 1.5rem;
  }

  .projects-list {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects-label {
    display: grid;
    gap: 0.45rem;
  }

  .projects-name {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* Lettered like the stage's name and the plan's title. */
  .projects-status {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* Controls that only mean something over the scene. */
  .projects-back,
  .projects-pager,
  .projects-model,
  .projects-veil {
    display: none;
  }

  /*
   * Over the scene: a layer as large as the screen that takes no clicks itself, hidden until the view opens.
   * It stays visible while its parts fade out, then hides; no transform on it, so the labels' --x/--y
   * are the viewport's.
   */
  :global(.js-experience) .projects {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: block;
    min-height: 0;
    padding: 0;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 1.2s;
  }

  :global(.js-experience) .projects[data-mode] {
    visibility: visible;
    transition: none;
  }

  /* The heading across the top, the way back at its right; on a narrow screen, under it. */
  :global(.js-experience) .projects-head {
    position: absolute;
    top: 6svh;
    inset-inline: clamp(1.25rem, 6vw, 6rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2.5rem;
  }

  :global(.js-experience) .projects-title {
    max-width: none;
    outline: none;
  }

  :global(.js-experience) .projects-back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--color-bone);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.15rem);
    letter-spacing: 0.01em;
    cursor: pointer;
  }

  .projects-back-list,
  .projects[data-mode='focus'] .projects-back-house {
    display: none;
  }

  .projects[data-mode='focus'] .projects-back-list {
    display: inline;
  }

  .projects-arrow,
  .projects-step svg,
  .projects-turner svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: translate 0.6s var(--ease-settle);
  }

  .projects-back:hover .projects-arrow,
  .projects-back:focus-visible .projects-arrow {
    translate: -0.35rem 0;
  }

  /* Each label hangs under its plan's near left corner, on a short leader along the sheet's edge. */
  :global(.js-experience) .projects-list {
    position: absolute;
    inset: 0;
    display: block;
  }

  :global(.js-experience) .projects-item {
    position: absolute;
    left: 0;
    top: 0;
    max-width: calc(100vw - var(--x, 0px) - 1.25rem);
    padding-top: 0.75rem;
    translate: var(--x, -100vw) var(--y, 0px);
  }

  :global(.js-experience) .projects-item::before {
    content: '';
    display: block;
    width: clamp(1.75rem, 4vw, 3.5rem);
    height: 1px;
    margin-bottom: 0.6rem;
    background: color-mix(in oklab, var(--color-bone) 45%, transparent);
    transition:
      width 0.9s var(--ease-settle),
      background-color 0.9s var(--ease-settle);
  }

  :global(.js-experience) .projects-label {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-bone);
    text-align: left;
    cursor: pointer;
    pointer-events: auto;
  }

  :global(.js-experience) .projects-name {
    transition: color 0.9s var(--ease-settle);
  }

  :global(.js-experience) .projects-item:has(.projects-label:is(:hover, :focus-visible, [data-active]))::before {
    width: clamp(3rem, 7vw, 6rem);
    background: var(--color-accent);
  }

  :global(.js-experience) .projects-label:is(:hover, :focus-visible, [data-active]) .projects-name {
    color: var(--color-accent);
  }

  /* The pager: in focus, and wherever only one plan fits on the screen. */
  :global(.js-experience) .projects-pager {
    position: absolute;
    right: clamp(1.25rem, 6vw, 6rem);
    bottom: 6svh;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.js-experience) .projects-step {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-bone);
    cursor: pointer;
  }

  .projects-step[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }

  .projects-step[data-projects-step='-1']:not([aria-disabled='true']):is(:hover, :focus-visible) svg {
    translate: -0.35rem 0;
  }

  .projects-step[data-projects-step='1']:not([aria-disabled='true']):is(:hover, :focus-visible) svg {
    translate: 0.35rem 0;
  }

  .projects-count {
    min-width: 3.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
    text-align: center;
    opacity: 0.55;
  }

  /*
   * The model in focus: its layers and how to turn it, where the heading was (the heading only reads over
   * the row). On a narrow screen, over the pager.
   */
  :global(.js-experience) .projects-model {
    position: absolute;
    top: 6svh;
    left: clamp(1.25rem, 6vw, 6rem);
    display: grid;
    gap: 0.75rem;
  }

  /* The layers read from the line to the volume, one word each; the one shown in copper, over a 1px line. */
  :global(.js-experience) .projects-layers {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .projects-layer {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--color-bone);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity 0.6s var(--ease-settle),
      color 0.6s var(--ease-settle),
      border-color 0.6s var(--ease-settle);
  }

  .projects-layer:is(:hover, :focus-visible) {
    opacity: 1;
  }

  .projects-layer[aria-pressed='true'] {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  :global(.js-experience) .projects-turn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition:
      opacity 0.6s var(--ease-settle),
      visibility 0s linear 0s;
  }

  /* The plan alone has no model to turn. */
  :global(.js-experience) .projects[data-layer='plano'] .projects-turn {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease-settle),
      visibility 0s linear 0.6s;
  }

  :global(.js-experience) .projects-turner {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-bone);
    cursor: pointer;
  }

  .projects-turner:is(:hover, :focus-visible) {
    color: var(--color-accent);
  }

  .projects-hint {
    margin: 0;
    white-space: nowrap;
    padding-inline: 0.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  /*
   * What shows at each step. Closed: nothing. The row: the heading, the way back, the labels once
   * their plans are drafted. A plan in focus: the way back, its label and the pager. What is not
   * shown is hidden too, not just transparent, so neither Tab nor the pointer can reach it: visibility
   * switches when the fade starts on the way in and when it ends on the way out. The heading only
   * fades: Tab and the pointer never reach it, and it takes focus the moment the view opens.
   */
  :global(.js-experience) .projects-title {
    opacity: 0;
    transition: opacity 0.6s var(--ease-settle);
  }

  :global(.js-experience) :is(.projects-back, .projects-item, .projects-pager, .projects-model) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease-settle),
      visibility 0s linear 0.6s;
  }

  :global(.js-experience) .projects[data-mode] :is(.projects-back, .projects-pager, .projects-layer, .projects-turner) {
    pointer-events: auto;
  }

  :global(.js-experience) .projects[data-mode='list'] .projects-title {
    opacity: 1;
    transition: opacity 1.2s var(--ease-settle) 0.9s;
  }

  :global(.js-experience) .projects[data-mode] .projects-back {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.2s var(--ease-settle) 0.9s,
      visibility 0s linear 0.9s;
  }

  :global(.js-experience) .projects[data-mode] .projects-item {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.2s var(--ease-settle) 2.6s,
      visibility 0s linear 2.6s;
  }

  :global(.js-experience) .projects[data-mode='focus'] :is(.projects-pager, .projects-model) {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.2s var(--ease-settle) 0.6s,
      visibility 0s linear 0.6s;
  }

  /*
   * In focus only the plan on screen keeps its label: the others fade with their sheets. They stay in the tab
   * order, and reaching one brings its plan into focus, but a pointer passes through them.
   */
  :global(.js-experience) .projects[data-mode='focus'] .projects-item:not(:has([aria-current])) {
    opacity: 0;
    transition: opacity 0.6s var(--ease-settle);
  }

  :global(.js-experience) .projects[data-mode='focus'] .projects-item:not(:has([aria-current])) .projects-label {
    pointer-events: none;
  }

  /* A step in focus brings the next plan's label in with its sheet, not after the row's first drafting. */
  :global(.js-experience) .projects[data-mode='focus'] .projects-item:has([aria-current]) {
    transition: opacity 0.9s var(--ease-settle) 0.3s;
  }

  /* Back from a plan the row is already drafted, so the labels return with their sheets instead of after the ink. */
  :global(.js-experience) .projects[data-mode='list'][data-seen] .projects-item {
    transition:
      opacity 0.9s var(--ease-settle) 0.3s,
      visibility 0s linear 0.3s;
  }

  /* The veil the reduced-motion crossfade fades the frame to. */
  :global(.js-experience) .projects-veil {
    position: fixed;
    inset: 0;
    z-index: 25;
    display: block;
    background: var(--color-base);
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    :global(.js-experience) .projects-head {
      flex-direction: column;
      align-items: flex-start;
    }

    :global(.js-experience) .projects[data-mode='list'] .projects-pager {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 1.2s var(--ease-settle) 2.6s,
        visibility 0s linear 2.6s;
    }

    :global(.js-experience) .projects-pager {
      right: auto;
      left: 50%;
      bottom: 4svh;
      translate: -50% 0;
    }

    /* The layers over the pager; the turn at either end of the pager's row, where the hint gives way. */
    :global(.js-experience) .projects-model {
      top: auto;
      inset-inline: 0.5rem;
      bottom: 4svh;
      gap: 0;
    }

    :global(.js-experience) .projects-layers {
      justify-content: center;
      gap: 0 1rem;
    }

    .projects-layer {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
    }

    :global(.js-experience) .projects-turn {
      justify-content: space-between;
    }

    .projects-hint {
      display: none;
    }
  }

  /* Under reduced motion the veil covers every change: nothing waits behind it. */
  :global(.js-experience.reduced-motion) .projects[data-mode] :is(.projects-title, .projects-back, .projects-item, .projects-pager, .projects-model) {
    transition-delay: 0s;
  }
</style>
