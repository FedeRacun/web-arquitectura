---
/*
 * Scene 1's quiet invitation to go on: the word "Bajar" over a thin arrow
 * drifting down. "Bajar" holds for every way down (wheel, swipe, keys), and
 * the hint is a button too: clicked or tapped, it takes the first step.
 */
---

<button type="button" class="scroll-hint" data-scroll-hint>
  <span class="scroll-hint-label">Bajar</span>
  <svg class="scroll-hint-arrow" viewBox="0 0 12 22" width="12" height="22" aria-hidden="true">
    <path d="M6 0.5V21M1.5 16.5L6 21L10.5 16.5" />
  </svg>
</button>

<style>
  .scroll-hint {
    display: none;
  }

  /* Shown and hidden by the scene (gsap autoAlpha), so a faded hint takes no clicks and no focus. */
  :global(.js-experience) .scroll-hint {
    position: fixed;
    left: 50%;
    bottom: 1svh;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.25rem;
    translate: -50% 0;
    border: 0;
    background: none;
    color: var(--color-bone);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
  }

  .scroll-hint-label {
    opacity: 0.6;
    transition: opacity 0.6s var(--ease-settle);
  }

  .scroll-hint:hover .scroll-hint-label,
  .scroll-hint:focus-visible .scroll-hint-label {
    opacity: 1;
  }

  .scroll-hint-arrow {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    animation: descend 3.2s var(--ease-settle) infinite;
  }

  /* Down and away, then again: a slow drift, never a bounce. */
  @keyframes descend {
    0% {
      translate: 0 -0.4rem;
      opacity: 0;
    }
    25% {
      opacity: 0.8;
    }
    75% {
      opacity: 0.8;
    }
    100% {
      translate: 0 0.4rem;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-arrow {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
